{
  "devDependencies": {
    "concurrently": "^10.0.5"
  },
"scripts": {
  "server": "cd app && node server.js",
  "client": "npm run dev --prefix client/app",
  "dev": "concurrently \"npm run server\" \"npm run client\"",
  "build": "npm install --prefix client/app && npm run build --prefix client/app"
  },
  "dependencies": {
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "firebase-admin": "^10.3.0"
  }

}
